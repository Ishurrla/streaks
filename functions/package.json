{
  "name": "functions",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "pnpm run build && firebase emulators:exec --project demo-streaks --only auth,firestore,functions \"vitest run\"",
    "test:unit": "vitest run test/unit --config vitest.unit.config.ts",
    "rollover:dev": "pnpm run build && node scripts/run-rollover.mjs"
  },
  "dependencies": {
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "luxon": "^3.7.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.20.5",
    "firebase": "^13.1.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
