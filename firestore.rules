rules_version = '2';

// Everything is denied unless a rule below allows it. Server code (the Next.js /api routes,
// using the Admin SDK) bypasses these rules, which is how server-owned fields get written.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function validUserName(v) {
      return v is string && v.size() >= 1 && v.size() <= 50;
    }

    function validHabitName(v) {
      return v is string && v.size() >= 1 && v.size() <= 40;
    }

    // 1 to 7 different weekdays, 0 = Monday to 6 = Sunday.
    function validDays(v) {
      return v is list && v.size() >= 1 && v.size() <= 7
        && v.toSet().size() == v.size()
        && v.toSet().hasOnly([0, 1, 2, 3, 4, 5, 6]);
    }

    function validColor(v) {
      return v in ['#13795B', '#3B6FD8', '#C2569A', '#D17F00', '#7A5BD6'];
    }

    match /users/{uid} {
      allow get: if isOwner(uid);

      // Created by `ensureProfile`, deleted by `deleteAccount`. Never by a client.
      allow create, delete: if false;

      // Clients may change only these four fields. `freezesAvailable`, `timezone`,
      // `nextRolloverAt`, `lastReminderDate`, `nextReminderAt` and anything else are
      // server-owned.
      allow update: if isOwner(uid)
        && changedKeys().hasOnly(['name', 'reminderEnabled', 'reminderTime', 'theme'])
        && (!('name' in changedKeys()) || validUserName(request.resource.data.name))
        && (!('reminderEnabled' in changedKeys()) || request.resource.data.reminderEnabled is bool)
        && (!('reminderTime' in changedKeys())
            || (request.resource.data.reminderTime is string
                && request.resource.data.reminderTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')))
        && (!('theme' in changedKeys()) || request.resource.data.theme in ['light', 'dark', 'system']);

      // Device tokens for push reminders. Saved and removed only through the
      // /api/register-push-token and /api/remove-push-token routes; the app never reads them.
      match /pushTokens/{tokenId} {
        allow read, write: if false;
      }

      match /habits/{habitId} {
        allow read: if isOwner(uid);

        // New habits start with zeroed, server-owned stats. `days` may be chosen here (left
        // out means every day) and `milestonesEarned` may only start empty; both are optional
        // so an older copy of the app can still add habits.
        allow create: if isOwner(uid)
          && exists(/databases/$(database)/documents/users/$(uid))
          && request.resource.data.keys().hasOnly(
               ['name', 'color', 'createdAt', 'currentStreak', 'bestStreak', 'lastCheckInDate',
                'days', 'milestonesEarned'])
          && request.resource.data.keys().hasAll(
               ['name', 'color', 'createdAt', 'currentStreak', 'bestStreak', 'lastCheckInDate'])
          && validHabitName(request.resource.data.name)
          && validColor(request.resource.data.color)
          && request.resource.data.createdAt == request.time
          && request.resource.data.currentStreak == 0
          && request.resource.data.bestStreak == 0
          && request.resource.data.lastCheckInDate == null
          && (!('days' in request.resource.data) || validDays(request.resource.data.days))
          && (!('milestonesEarned' in request.resource.data) || request.resource.data.milestonesEarned == []);

        // Only the name and colour. Everything else is server-owned: the stats
        // (`currentStreak`, `bestStreak`, `lastCheckInDate`), `milestonesEarned`, and the
        // schedule after creation (`days`, `nextDays`, `nextDaysFrom`, `pastDays`), which
        // changes only through /api/update-habit-days so a change always starts tomorrow.
        allow update: if isOwner(uid)
          && changedKeys().hasOnly(['name', 'color'])
          && validHabitName(request.resource.data.name)
          && validColor(request.resource.data.color);

        // Goes through `deleteHabit`, which also removes the subcollections.
        allow delete: if false;

        // Written only by `checkIn`, `undoCheckIn` and the rollover job.
        match /checkIns/{localDate} {
          allow read: if isOwner(uid);
          allow write: if false;
        }

        match /freezeUses/{localDate} {
          allow read: if isOwner(uid);
          allow write: if false;
        }
      }
    }
  }
}
