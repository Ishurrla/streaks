# Leave these empty for local development: the app then uses the Firebase Emulator Suite
# with the demo-streaks project. Set them (for example in Vercel) for a real project.
# These values are public client config, not secrets.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# Firebase console > Project settings > Cloud Messaging > Web Push certificates > Key pair.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Force the emulators even when the config above is set. Push still uses the real project's
# FCM, so this is the way to try real notifications locally before deploying.
# NEXT_PUBLIC_FIREBASE_USE_EMULATORS=true
