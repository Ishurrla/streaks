# Copy to apps/web/.env.local (git-ignored) and fill in. Restart `pnpm dev` after changing it.
# These are public client config, not secrets, but keep them out of git anyway.
#
# Which mode the app runs in:
#   No .env.local at all          -> emulators only, demo-streaks project. Nothing to fill in.
#   Values below + the emulator   -> Auth and Firestore stay on the emulators; only push
#   flag at the bottom set           notifications use your real project. Use this to try real
#                                    notifications locally.
#   Values below, no emulator     -> the app talks to your REAL project (real users, real data).
#   flag                             This is what Vercel uses. Avoid it locally.
#
# Where to find the values: Firebase console > Project settings (gear icon) > General >
# Your apps > the "Streaks" web app > SDK setup and configuration > Config.
# Or print them with:  node scripts/firebase.mjs apps:sdkconfig WEB --project prod

# firebaseConfig.apiKey
NEXT_PUBLIC_FIREBASE_API_KEY=
# firebaseConfig.authDomain, e.g. streaks-b1dca.firebaseapp.com
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# firebaseConfig.projectId, e.g. streaks-b1dca
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# firebaseConfig.appId, e.g. 1:307256419017:web:...
NEXT_PUBLIC_FIREBASE_APP_ID=
# firebaseConfig.messagingSenderId (the project number), e.g. 307256419017
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Project settings > Cloud Messaging > Web Push certificates > Generate key pair.
# Copy the long public key ("Key pair"), not the private key.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Keep Auth and Firestore (and the /api routes) on the emulators even though the values above are set.
# Uncomment for local work with real config. Never set it in Vercel.
# NEXT_PUBLIC_FIREBASE_USE_EMULATORS=true

# Only if the emulators run on another machine or in a container. Default 127.0.0.1.
# NEXT_PUBLIC_EMULATOR_HOST=127.0.0.1

# ---------------------------------------------------------------------------------------
# Server only. These never get the NEXT_PUBLIC_ prefix, so they never reach the browser.
# Not needed locally: on the emulators the server uses the demo-streaks project and no
# credentials. Set them in Vercel (Production) for the real project.

# Service account for the Firebase Admin SDK: Firebase console > Project settings >
# Service accounts > Generate new private key. Copy project_id, client_email and
# private_key from the downloaded JSON, then delete the file. Paste the key with its
# "\n" sequences as they are; the server turns them back into newlines.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Shared secret the GitHub Actions cron sends as "Authorization: Bearer <CRON_SECRET>".
# Any long random string, e.g. the output of: openssl rand -hex 32
CRON_SECRET=
